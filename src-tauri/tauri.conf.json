{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ivlyrics-overlay",
  "version": "1.3.2",
  "identifier": "com.ivlis.lyrics-plus-overlay",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ivLyrics Overlay",
        "width": 500,
        "height": 200,
        "x": 100,
        "y": 100,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://api.github.com https://github.com",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2RDUyMzdENDVCNERBOUYKUldTZjJyUkZmU1BWOWpUbVhuekJiTmx1N3FERFl0c2ZMRkh5ajM0REFHenFnVjJlK3pPNk5FdVUK",
      "endpoints": [
        "https://github.com/ivLis-Studio/ivLyrics-overlay/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ivlyrics-overlay",
          "lyrics-plus-overlay"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Synced lyrics overlay for Spotify",
    "longDescription": "Keep the current lyric line visible on top of other windows while Spotify plays. ivLyrics Overlay receives synced lyrics and playback position from ivLyrics for PC over a local connection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Korean"
        ]
      }
    }
  }
}
